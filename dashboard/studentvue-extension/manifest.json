{
  "manifest_version": 3,
  "name": "Workflow gradebook companion",
  "version": "1.0.0",
  "description": "Read the course grades visible in your FCPS StudentVUE Grade Book for Workflow.",
  "key": "",
  "background": { "service_worker": "background.js" },
  "incognito": "not_allowed",
  "host_permissions": ["https://sisstudent.fcps.edu/*"],
  "externally_connectable": {
    "matches": ["https://workflow.sites.tjhsst.edu/app"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://sisstudent.fcps.edu/SVUE/PXP2_Gradebook.aspx*",
        "https://sisstudent.fcps.edu/SVUE/PXP2_GradeBook.aspx*",
        "https://sisstudent.fcps.edu/svue/PXP2_Gradebook.aspx*",
        "https://sisstudent.fcps.edu/svue/PXP2_GradeBook.aspx*"
      ],
      "js": ["gradebook.js"]
    }
  ]
}
